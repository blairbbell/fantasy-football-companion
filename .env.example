# Copy to .env (git-ignored). Environment variables override config.json.
FF_SEASON=2026
# Single league via env instead of config.json "leagues" (leave unset to use config.json or discover):
# FF_LEAGUE_ID=123456
# FF_TEAM_ID=1
# FF_LEAGUE_NAME=My league
# FF_DATA_DIR=data
# FF_CONFIG=config.json

# Either point at a cookie file...
# ESPN_COOKIES_FILE=espn_cookies.json
# ...or put the two cookie values here (never commit .env):
ESPN_S2=
ESPN_SWID=

# Optional notifications (pick one, or leave both empty to just log):
# FF_NOTIFY_CMD=/path/to/my-push-script
# FF_NOTIFY_URL=https://ntfy.example.com/my-private-topic
